{
  "llm": {
    "models": {
      "gpt4o-mini": {
        "base_url": "https://api.openai.com/v1",
        "model": "gpt-4o-mini",
        "env_key": "OPENAI_API_KEY",
        "rpm": 500,
        "tpm": 200000,
        "rpd": 10000
      },
      "gpt4o": {
        "base_url": "https://api.openai.com/v1",
        "model": "gpt-4o",
        "env_key": "OPENAI_API_KEY"
      },
      "gemini25-flash": {
        "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "model": "gemini-2.5-flash",
        "env_key": "GEMINI_API_KEY"
      },
      "gemini25-pro": {
        "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "model": "gemini-2.5-pro",
        "env_key": "GEMINI_API_KEY"
      },
      "deepseek-v3": {
        "base_url": "https://api.deepseek.com",
        "model": "deepseek-chat",
        "env_key": "DEEPSEEK_API_KEY"
      },
      "or-gpt4o-mini": {
        "base_url": "https://openrouter.ai/api/v1",
        "model": "openai/gpt-4o-mini",
        "env_key": "OPENROUTER_API_KEY"
      }
    },
    "inactive": {
      "qwen3-8b": {
        "base_url": "http://localhost:11434/v1",
        "model": "qwen3:8b"
      },
      "qwen3-32b": {
        "base_url": "http://localhost:11434/v1",
        "model": "qwen3:32b"
      },
      "gemma3-12b": {
        "base_url": "http://localhost:11434/v1",
        "model": "gemma3:12b"
      },
      "gemma3-27b": {
        "base_url": "http://localhost:11434/v1",
        "model": "gemma3:27b"
      },
      "llama31-8b": {
        "base_url": "http://localhost:11434/v1",
        "model": "llama3.1:8b"
      }
    }
  },
  "embedding": {
    "models": {
      "bge-m3": "BAAI/bge-m3"
    },
    "inactive": {
      "labse": "sentence-transformers/LaBSE",
      "e5-large": {
        "model": "intfloat/e5-large-v2",
        "query_prefix": "query: ",
        "document_prefix": "query: "
      },
      "qwen-06b": "Qwen/Qwen3-Embedding-0.6B",
      "qwen-4b": {
        "model": "Qwen/Qwen3-Embedding-4B",
        "dtype": "auto",
        "query_prefix": "Instruct: Retrieve stories with a similar narrative to the given story\nQuery:",
        "document_prefix": ""
      },
      "qwen-4b-coa-prefix": {
        "model": "Qwen/Qwen3-Embedding-4B",
        "dtype": "auto",
        "query_prefix": "Instruct: Represent the sequence of events and plot of this story for narrative-similarity retrieval, disregarding theme and setting\nQuery: ",
        "document_prefix": "Instruct: Represent the sequence of events and plot of this story for narrative-similarity retrieval, disregarding theme and setting\nQuery: ",
        "label": "Qwen3-4B · CoA prefix"
      },
      "qwen-4b-coa-extract": {
        "model": "Qwen/Qwen3-Embedding-4B",
        "dtype": "auto",
        "preprocess_prompt": "course_of_action",
        "label": "Qwen3-4B · CoA extract"
      },
      "story-emb": {
        "model": "uhhlt/story-emb",
        "dtype": "auto",
        "query_prefix": "Instruct: Retrieve stories with a similar narrative to the given story\nQuery: ",
        "document_prefix": ""
      },
      "bge-m3-summary": {
        "model": "BAAI/bge-m3",
        "preprocess_prompt": "summary",
        "label": "BGE-M3 · summary"
      }
    }
  }
}
