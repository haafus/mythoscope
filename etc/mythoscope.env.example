# Installed to /etc/mythoscope/env by `fab bootstrap` (root:mythoscope, 0640).
# Read by the systemd unit via EnvironmentFile=. Never rsynced — edit on the server.
#
# systemd parses this file itself: KEY=value, no `export`, no shell expansion,
# no inline comments after a value.

# Bind loopback only; Caddy is the public entry point. Do not set 0.0.0.0 —
# that would expose uvicorn directly, bypassing TLS and the proxy.
MYTHO_SERVER__HOST=127.0.0.1
# Caddy proxies this exact port. Changing it here alone makes the site 502 while
# the app stays healthy on loopback — change APP_PORT in fabfile.py and re-run
# `fab bootstrap` instead. `fab smoke` fails loudly if the two disagree.
MYTHO_SERVER__PORT=8000

MYTHO_LOG_LEVEL=INFO
MYTHO_LOGS_MAX_FILES=20

# Text-query search needs sentence-transformers + torch, which the `viewer`
# extra deliberately omits. Leaving this false keeps /api/similarity/search
# returning 503 instead of failing at import. To enable it you must also add
# `search` to EXTRAS in fabfile.py and redeploy (pulls ~2.5GB of torch).
MYTHO_SERVER__TEXT_SEARCH=false

# The viewer makes no LLM calls — no OPENAI_API_KEY etc. belongs here. Keys are
# only needed on the machine that builds outputs/.
