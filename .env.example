# All variables are optional — defaults work out of the box.
# Reads from .env or config/.env

# --- Paths (relative to project root or absolute) ---
# MYTHO_CORPUS_DIR=outputs/corpus
# MYTHO_EMBEDDINGS_DIR=outputs/embeddings
# MYTHO_PROJECTIONS_DIR=outputs/projections
# MYTHO_LOGS_DIR=outputs/logs
# MYTHO_GRAPHS_DIR=outputs/graphs
# MYTHO_MOTIFS_DIR=outputs/motifs

# --- LLM per algorithm (alias from config/models.json) ---
# Graph extraction:
# MYTHO_GRAPHS__LLM=gpt4o-mini
# MYTHO_GRAPHS__TEMPERATURE=0.1
# Chunk preprocessing (summary embedding variants):
# MYTHO_EMBEDDING__LLM=gpt4o-mini
# MYTHO_EMBEDDING__TEMPERATURE=0.1
# Per-model rate limits (rpm/tpm/rpd) live in config/models.json, not here.

# --- Parallelism (saturation cap; the rate limiter is the real throttle) ---
# Parallel chunks during graph extraction:
# MYTHO_GRAPHS__MAX_CONCURRENT=18
# Parallel summaries during motif analysis:
# MYTHO_PROJECTIONS__MAX_CONCURRENT=5

# --- Embeddings ---
# MYTHO_EMBEDDING__DEFAULT_CHUNKING=paragraph
# Use only locally cached HF models — no network calls (unset to allow downloads):
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# --- Motifs (motif database build) ---
# MYTHO_MOTIFS__MAX_WORKERS=10          # concurrent Berezkin detail-page fetches
# MYTHO_MOTIFS__BEREZKIN_DETAILS=true   # fetch per-motif definitions (one request each)

# --- Server ---
# MYTHO_SERVER__HOST=127.0.0.1
# MYTHO_SERVER__PORT=8000

# --- Logging ---
# MYTHO_LOG_LEVEL=INFO
# Per-run log files kept in logs_dir (<=0 = keep all):
# MYTHO_LOGS_MAX_FILES=20

# --- API keys / credentials (read from the environment, not by pydantic-settings) ---
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# HF_TOKEN=hf_...
# MAPSOFMYTHS_AUTH=user:pass            # mapsofmyths.com basic-auth for the Berezkin enrichment (blank = step skipped)
